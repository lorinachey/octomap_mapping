<!--
  Example launch file for octomap_server mapping:
  Listens to incoming PointCloud2 data and incrementally builds an octomap.
  The data is sent out in different representations.

  Copy this file into your workspace and adjust as needed, see
  www.ros.org/wiki/octomap_server for details
-->
<launch>
	<node pkg="octomap_server" exec="octomap_server_node" name="octomap_server">
		<param name="resolution" value="0.1" />

		<!-- fixed map frame (set to 'map' if SLAM or localization running!) -->
		<param name="frame_id" value="map" />

		<param name="use_sim_time" value="true" />

		<!-- filter out points above and below these heights -->
		<param name="filter_max_z" value="3.0" />

		<!-- maximum range (in meters) to integrate (speedup!) -->
		<param name="sensor_model.max_range" value="3.0" />

		<!-- sensor model parameters -->
		<param name="sensor_model.prob_hit" value="0.70" />
		<param name="sensor_model.prob_miss" value="0.12" />
		<param name="sensor_model.clamping_thres_min" value="0.20" />
		<param name="sensor_model.clamping_thres_max" value="0.97" />

		<param name="filter_ground_plane" value="false" />

		<!-- data source to integrate (PointCloud2) -->
		<remap from="cloud_in" to="/front_3d_lidar/lidar_points" />
	</node>
</launch>
